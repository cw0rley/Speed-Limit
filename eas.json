{
  "cli": {
    "version": ">= 18.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "environment": "preview"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6763160045"
      },
      "android": {
        "serviceAccountKeyPath": "../Workout/prforgd/google-service-account.json",
        "track": "production"
      }
    }
  }
}
