{
  "expo": {
    "name": "Speed Limit",
    "slug": "speed-limit",
    "version": "1.1.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.claytonrugby.speedlimit",
      "appleTeamId": "N27NV97893",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Speed Limit uses your location to show your current driving speed and the speed limit of the road you're on.",
        "NSMicrophoneUsageDescription": "Speed Limit may use the microphone for voice input on CarPlay.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.claytonrugby.speedlimit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Speed Limit to use your location to show driving speed and speed limits.",
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Speed Limit uses your location while driving, including in the background, to keep your speed and the speed limit up to date on CarPlay and the Lock Screen."
        }
      ],
      "./plugins/withCarPlay",
      "@bacons/apple-targets",
      "./plugins/withoutAndroidAuto",
      "./plugins/withoutBackgroundFetch"
    ],
    "extra": {
      "eas": {
        "projectId": "c659ab4d-9909-44da-b96b-00aad54ceb97"
      },
      "subscription": {
        "mode": "off",
        "startDate": "",
        "iosApiKey": "appl_nFWciiGjNDZOksUmlzlQlRpjWoK",
        "androidApiKey": "",
        "privacyUrl": ""
      }
    }
  }
}